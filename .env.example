# For running the stack locally. Copy to .env and fill in; .env is gitignored.
# The server's .env is not made from this file: scripts/deploy.sh renders it
# from the environment (~/.secrets on era-arch).

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your own Telegram numeric chat id. Every other chat is ignored.
# Get it by messaging @userinfobot.
TELEGRAM_OWNER_CHAT_ID=0

# Postgres credentials, used by both the db and app containers.
POSTGRES_DB=accountability
POSTGRES_USER=accountability
POSTGRES_PASSWORD=change-me

# Unlocks the test-mode commands /lambda and /simulate.
BOT_TESTMODE=false

IMAGE_TAG=latest
