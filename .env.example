# Copy to .env on era-server and fill in. .env is gitignored.

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your own Telegram numeric chat id. Every other chat is ignored.
# Get it by messaging @userinfobot.
TELEGRAM_OWNER_CHAT_ID=0

# Postgres credentials, used by both the db and app containers.
POSTGRES_DB=accountability
POSTGRES_USER=accountability
POSTGRES_PASSWORD=change-me

# Unlocks the test-mode commands /lambda and /simulate.
# Leave false on a real deployment.
BOT_TESTMODE=false

# Image tag deployed by scripts/deploy.sh.
IMAGE_TAG=latest

# era-arch addresses, read by scripts/deploy.sh on era-server.
# BUILD_HOST is required, BUILD_HOST_TS (Tailscale) is an optional fallback.
BUILD_HOST=
BUILD_HOST_TS=
